{
  "name": "@yeliu84/pi-model-router",
  "version": "0.5.4",
  "type": "module",
  "files": [
    "extensions",
    "!extensions/*.test.ts",
    "LICENSE",
    "model-router.example.json",
    "model-router.schema.json",
    "README.md"
  ],
  "description": "Smart per-turn model router for Pi that optimizes your AI budget and usage limits by dynamically switching LLM tiers based on task complexity, budget, and phase awareness.",
  "keywords": [
    "pi-package",
    "pi",
    "model-router",
    "llm",
    "coding-agent",
    "extension"
  ],
  "license": "MIT",
  "author": "Ye Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeliu84/pi-model-router.git"
  },
  "homepage": "https://github.com/yeliu84/pi-model-router#readme",
  "bugs": {
    "url": "https://github.com/yeliu84/pi-model-router/issues"
  },
  "exports": {
    ".": "./extensions/index.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run tsc",
    "test": "vitest run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.73.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.4"
  }
}
